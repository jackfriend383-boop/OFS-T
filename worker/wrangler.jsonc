{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ofst-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Websites allowed to call this API (comma separated, origins only: no path, no trailing slash).
    "SITE_URL": "https://ofstdesigns.com",
    // Domain must be verified in Resend (guides/CLOUDFLARE-SETUP.md).
    "MAIL_FROM": "OFS/T <geral@ofstdesigns.com>",
    "ALLOWED_ORIGINS": "https://ofstdesigns.com,https://admin.ofstdesigns.com,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://localhost:4173"
  },
  // Per-visitor request limits, enforced in memory by Cloudflare before any database work (see throttle() in src/index.ts).
  // RL = every API call; RL_STRICT = sign-in, account and checkout calls. `period` can only be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_STRICT", "namespace_id": "1002", "simple": { "limit": 15, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ofst-orders",
      "database_id": "04c1483a-9024-4a67-9706-0131e7e94feb"
    }
  ]
}
